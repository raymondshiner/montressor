#!/usr/bin/env bash
# Launch Magic: The Gathering Online under Proton (UMU-Proton via umu-launcher).
#
# WHY PROTON (2026-07-09): MTGO is a WPF app. Under plain Wine its hardware render
# path blits to the window in a way that goes BLACK on XWayland, forcing a choice
# between slow software WPF (laggy) or Wine's Wayland driver (fast but broken
# clipboard). Proton's patched Wine + DXVK render WPF hardware-accelerated AND
# present correctly under XWayland — all three at once: not black, fast, clipboard.
#
# MTGO is a ClickOnce "networked deployed" app: launch it by forcing a fresh ONLINE
# activation against its deployment manifest via dfshim's ShOpenVerbApplication verb.
#
# Prefix ~/Games/mtgo-proton was cloned from the old Wine prefix (keeps the real
# .NET Framework 4.8 that MTGO needs) and adopted by Proton. Full history +
# fallback configs: ~/.claude/.../memory/project_mtgo_proton.md.

export WINEPREFIX="$HOME/Games/mtgo-proton"
export GAMEID="umu-mtgo"
export PROTONPATH="$HOME/.local/share/Steam/compatibilitytools.d/UMU-Proton-10.0-4"
export PROTON_VERB="run"
export WINEDEBUG=-all

MANIFEST_URL="http://mtgo.patch.daybreakgames.com/patch/mtg/live/client/MTGO.application"

# Already running? Don't spawn a second copy.
if pgrep -x MTGO.exe >/dev/null 2>&1; then
    notify-send "MTGO" "Magic: The Gathering Online is already running." 2>/dev/null
    exit 0
fi

# Bump the CPU to the "performance" power profile ONLY while MTGO runs, then restore
# the previous profile on exit. power-profiles-daemon otherwise idles this laptop at
# powersave/balanced. Uses powerprofilesctl (user-level, no sudo). A detached watcher
# waits for MTGO to appear (Proton staging can be slow), holds performance for its
# lifetime, and reverts when it closes.
if command -v powerprofilesctl >/dev/null 2>&1; then
    PREV_PROFILE="$(powerprofilesctl get 2>/dev/null || echo balanced)"
    powerprofilesctl set performance 2>/dev/null
    (
        for _ in $(seq 1 120); do pgrep -x MTGO.exe >/dev/null 2>&1 && break; sleep 1; done
        while pgrep -x MTGO.exe >/dev/null 2>&1; do sleep 5; done
        powerprofilesctl set "$PREV_PROFILE" 2>/dev/null
    ) >/dev/null 2>&1 &
    disown 2>/dev/null
fi

exec umu-run rundll32.exe "dfshim.dll,ShOpenVerbApplication" "$MANIFEST_URL"
