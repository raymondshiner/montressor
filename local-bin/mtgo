#!/usr/bin/env bash
# Launch Magic: The Gathering Online under Wine.
#
# MTGO is a ClickOnce "networked deployed" app. It refuses to start from the
# raw MTGO.exe ("must be started from the shortcut created by the installation
# process"), and Wine's ClickOnce shortcut activation (the .appref-ms via
# dfshim ShOpenVerbShortcut) fails with "application cannot be started, contact
# the vendor". The reliable path is to force a fresh ONLINE activation against
# MTGO's deployment manifest URL with dfshim's ShOpenVerbApplication verb — this
# revalidates/patches the client and launches it correctly every time.

export WINEPREFIX="$HOME/Games/mtgo-wine"
export WINEARCH=win64
export WINEDEBUG=-all

MANIFEST_URL="http://mtgo.patch.daybreakgames.com/patch/mtg/live/client/MTGO.application"

# If MTGO is already running, just focus-launch a no-op instead of a second copy.
if pgrep -x MTGO.exe >/dev/null 2>&1; then
    notify-send "MTGO" "Magic: The Gathering Online is already running." 2>/dev/null
    exit 0
fi

exec wine rundll32.exe dfshim.dll,ShOpenVerbApplication "$MANIFEST_URL"
