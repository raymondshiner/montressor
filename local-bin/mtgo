#!/usr/bin/env bash
# Launch Magic: The Gathering Online under Wine.
#
# MTGO is a ClickOnce "networked deployed" app. It refuses to start from the
# raw MTGO.exe ("must be started from the shortcut created by the installation
# process"), and Wine's ClickOnce shortcut activation (the .appref-ms via
# dfshim ShOpenVerbShortcut) fails with "application cannot be started, contact
# the vendor". The reliable path is to force a fresh ONLINE activation against
# MTGO's deployment manifest URL with dfshim's ShOpenVerbApplication verb — this
# revalidates/patches the client and launches it correctly every time.

export WINEPREFIX="$HOME/Games/mtgo-wine"
export WINEARCH=win64
export WINEDEBUG=-all

# Responsiveness: CachyOS kernel ships futex2/fsync — use it (falls back to
# esync if fsync is unavailable). Big win for Wine's thread scheduling / input lag.
export WINEFSYNC=1
export WINEESYNC=1

# HARDWARE WPF via Wine's native Wayland driver.
# Background (2026-07-09): WPF's hardware path renders correctly but its blit to the
# window goes BLACK under XWayland (proven: black regardless of GPU/DXVK). The fix is
# to bypass XWayland — the prefix sets HKCU\Software\Wine\Drivers\Graphics="wayland,x11"
# and HW acceleration is re-enabled (Avalon.Graphics\DisableHWAcceleration removed).
# Unsetting DISPLAY makes Wine prefer the Wayland driver so the previously-black HW
# render displays AND page-switching is GPU-accelerated (no CPU software rasterization).
# REVERT to the safe software path if anything regresses:
#   WINEPREFIX=~/Games/mtgo-wine wine reg add 'HKCU\Software\Microsoft\Avalon.Graphics' \
#     /v DisableHWAcceleration /t REG_DWORD /d 1 /f
export DXVK_FILTER_DEVICE_NAME="Intel"   # keep DXVK on the display GPU (no cross-GPU hop)
unset DISPLAY                            # prefer winewayland.drv over XWayland

MANIFEST_URL="http://mtgo.patch.daybreakgames.com/patch/mtg/live/client/MTGO.application"

# If MTGO is already running, just focus-launch a no-op instead of a second copy.
if pgrep -x MTGO.exe >/dev/null 2>&1; then
    notify-send "MTGO" "Magic: The Gathering Online is already running." 2>/dev/null
    exit 0
fi

# Responsiveness: bump the CPU to the "performance" power profile ONLY while MTGO
# runs, then restore the previous profile on exit. Helps Wine/client thread latency;
# power-profiles-daemon otherwise idles this laptop at powersave/balanced. Uses
# powerprofilesctl (user-level, no sudo). A detached watcher waits for MTGO to
# appear, holds performance for its lifetime, and reverts when it closes.
if command -v powerprofilesctl >/dev/null 2>&1; then
    PREV_PROFILE="$(powerprofilesctl get 2>/dev/null || echo balanced)"
    powerprofilesctl set performance 2>/dev/null
    (
        for _ in $(seq 1 90); do pgrep -x MTGO.exe >/dev/null 2>&1 && break; sleep 1; done
        while pgrep -x MTGO.exe >/dev/null 2>&1; do sleep 5; done
        powerprofilesctl set "$PREV_PROFILE" 2>/dev/null
    ) >/dev/null 2>&1 &
    disown 2>/dev/null
fi

exec wine rundll32.exe dfshim.dll,ShOpenVerbApplication "$MANIFEST_URL"
