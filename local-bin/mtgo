#!/usr/bin/env bash
# Launch Magic: The Gathering Online under Wine.
#
# MTGO is a ClickOnce "networked deployed" app: launch it by forcing a fresh ONLINE
# activation against its deployment manifest via dfshim's ShOpenVerbApplication verb.
#
# RENDERING — software WPF on XWayland (stable + clipboard, but page-switch lag).
# The full trilemma (proven 2026-07-09; details in memory/project_mtgo_proton.md):
#   - Software WPF + XWayland   -> stable, not black, CLIPBOARD works, but laggy  <-- here
#   - Wine Wayland driver + HW  -> stable, not black, fast, but CLIPBOARD BREAKS
#   - plain Wine XWayland + HW  -> BLACK window (WPF HW blit fails on XWayland)
#   - Proton + HW               -> CRASHES ~15s (WPF PresentationCore D3D9 exception)
# There is no config with all three (not-black + fast + clipboard); HW-accelerated
# WPF is unstable/broken on this Wayland + hybrid-GPU machine. Clipboard is required,
# so software is the pick. To trade clipboard for speed, use the Wayland driver:
#   wine reg add 'HKCU\Software\Wine\Drivers' /v Graphics /d 'wayland,x11' /f
#   wine reg delete 'HKCU\Software\Microsoft\Avalon.Graphics' /v DisableHWAcceleration /f
#   and add `unset DISPLAY` below.

export WINEPREFIX="$HOME/Games/mtgo-wine"
export WINEARCH=win64
export WINEDEBUG=-all

# Responsiveness: CachyOS kernel ships futex2/fsync — use it (falls back to esync).
export WINEFSYNC=1
export WINEESYNC=1

MANIFEST_URL="http://mtgo.patch.daybreakgames.com/patch/mtg/live/client/MTGO.application"

# Already running? Don't spawn a second copy.
if pgrep -x MTGO.exe >/dev/null 2>&1; then
    notify-send "MTGO" "Magic: The Gathering Online is already running." 2>/dev/null
    exit 0
fi

# Bump the CPU to the "performance" power profile ONLY while MTGO runs, then restore
# the previous profile on exit (powerprofilesctl, user-level, no sudo). Helps the
# CPU-bound software WPF page compositing. A detached watcher waits for MTGO to
# appear, holds performance for its lifetime, and reverts when it closes.
if command -v powerprofilesctl >/dev/null 2>&1; then
    PREV_PROFILE="$(powerprofilesctl get 2>/dev/null || echo balanced)"
    powerprofilesctl set performance 2>/dev/null
    (
        for _ in $(seq 1 90); do pgrep -x MTGO.exe >/dev/null 2>&1 && break; sleep 1; done
        while pgrep -x MTGO.exe >/dev/null 2>&1; do sleep 5; done
        powerprofilesctl set "$PREV_PROFILE" 2>/dev/null
    ) >/dev/null 2>&1 &
    disown 2>/dev/null
fi

exec wine rundll32.exe dfshim.dll,ShOpenVerbApplication "$MANIFEST_URL"
