#!/usr/bin/env bash
# Launch Magic: The Gathering Arena (Steam app 2141910) under Proton on the dGPU.
#
# GPU — NVIDIA PRIME render offload. Unlike MTGO (WPF, see memory/project_mtgo_proton.md),
# MTGA is a Unity/DX11 game, so DXVK->Vulkan is the normal Proton path and the WPF
# XWayland black-window trilemma does not apply. ProtonDB: Platinum (0.81, 110 reports).
#
# The offload vars are NOT set here: `steam -applaunch` hands off via IPC to the
# already-running Steam client, so this script's environment never reaches the game.
# They live in Steam's per-game LaunchOptions instead (localconfig.vdf, set 2026-07-28):
#   __NV_PRIME_RENDER_OFFLOAD=1 __GLX_VENDOR_LIBRARY_NAME=nvidia __VK_LAYER_NV_optimus=NVIDIA_only %command%
# __VK_LAYER_NV_optimus is the one that matters — DXVK is a Vulkan client.
# To fall back to the iGPU (if Optimus lockups show up), clear that field in Steam.
#
# Muxless Optimus: the 4060 has no path to the internal panel, so every frame is
# copied to Intel for scanout. An external HDMI monitor scans out NVIDIA-direct and
# skips the copy — that's the config that actually uses the card properly.

APPID=2141910
PROC=MTGA.exe

if pgrep -x "$PROC" >/dev/null 2>&1; then
    notify-send "MTGA" "Magic: The Gathering Arena is already running." 2>/dev/null
    exit 0
fi

# Hold the "performance" power profile for MTGA's lifetime, then restore the previous
# one. Detached watcher; same pattern as the mtgo launcher.
if command -v powerprofilesctl >/dev/null 2>&1; then
    PREV_PROFILE="$(powerprofilesctl get 2>/dev/null || echo balanced)"
    powerprofilesctl set performance 2>/dev/null
    (
        for _ in $(seq 1 120); do pgrep -x "$PROC" >/dev/null 2>&1 && break; sleep 1; done
        while pgrep -x "$PROC" >/dev/null 2>&1; do sleep 5; done
        powerprofilesctl set "$PREV_PROFILE" 2>/dev/null
    ) >/dev/null 2>&1 &
    disown 2>/dev/null
fi

exec steam -applaunch "$APPID"
