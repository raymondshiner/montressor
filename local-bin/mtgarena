#!/usr/bin/env bash
# MTG Arena launcher — official self-updating client installed in a user-owned
# wine prefix (replaces the old AUR /opt bundle that couldn't self-patch).
export WINEPREFIX="${HOME}/.local/share/mtgarena"
export WINEARCH=win64
export WINEDEBUG=-all

exec wine "${WINEPREFIX}/drive_c/Program Files (x86)/Wizards of the Coast/MTGA/MTGA.exe" "$@"
