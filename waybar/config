[{
    "name": "top",
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 0,
    "modules-left": [
        "custom/ws-listener",
        "custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5",
        "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10",
        "custom/wsn1", "custom/wsn2",
        "custom/workspace-menu"
    ],
    "modules-center": ["custom/obsidian-sp", "clock", "custom/obsidian"],
    "modules-right": ["tray", "custom/drives", "swaync", "custom/displays", "bluetooth", "pulseaudio", "battery", "network", "custom/vpn", "group/hardware", "custom/tasks", "custom/apps-menu"],

    "custom/ws-listener": {
        "exec": "~/.config/waybar/ws-listen.sh",
        "format": ""
    },

    "custom/ws1": {
        "exec": "~/.config/waybar/ws-button.sh 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 1",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 1"
    },
    "custom/ws2": {
        "exec": "~/.config/waybar/ws-button.sh 2",
        "return-type": "json",
