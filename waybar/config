        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 2",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 2"
    },
    "custom/ws3": {
        "exec": "~/.config/waybar/ws-button.sh 3",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 3",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 3"
    },
    "custom/ws4": {
        "exec": "~/.config/waybar/ws-button.sh 4",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 4",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 4"
    },
    "custom/ws5": {
        "exec": "~/.config/waybar/ws-button.sh 5",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 5",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 5"
    },
    "custom/ws6": {
        "exec": "~/.config/waybar/ws-button.sh 6",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 6",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 6"
    },
    "custom/ws7": {
        "exec": "~/.config/waybar/ws-button.sh 7",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 7",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 7"
    },
    "custom/ws8": {
        "exec": "~/.config/waybar/ws-button.sh 8",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 8",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 8"
    },
    "custom/ws9": {
        "exec": "~/.config/waybar/ws-button.sh 9",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 9",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 9"
    },
    "custom/ws10": {
        "exec": "~/.config/waybar/ws-button.sh 10",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "hyprctl dispatch workspace 10",
        "on-click-right": "~/.config/waybar/ws-open-popup.sh 10"
    },

    "custom/wsn1": {
        "exec": "~/.config/waybar/ws-button-named.sh 1",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "~/.config/waybar/ws-switch-named.sh 1"
    },
    "custom/wsn2": {
        "exec": "~/.config/waybar/ws-button-named.sh 2",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "hide-empty-text": true,
        "tooltip": false,
        "on-click": "~/.config/waybar/ws-switch-named.sh 2"
    },

    "custom/workspace-menu": {
        "format": "󱂬",
        "tooltip": false,
        "on-click": "~/.config/waybar/workspace-popup.py"
    },

    "custom/apps-menu": {
        "format": "󰣘",
        "tooltip": false,
        "on-click": "python3 ~/.config/waybar/apps-menu-popup.py"
    },

    "custom/tasks": {
        "format": "󰖯",
        "tooltip": false,
        "on-click": "python3 ~/.config/waybar/tasks-popup.py"
    },

    "clock": {
        "format": "{:%a %b %d   %I:%M %p}",
        "tooltip": false,
        "on-click": "~/.config/waybar/calendar-popup.py"
    },

    "custom/obsidian": {
        "format": "",
        "tooltip": false,
        "on-click": "~/.local/bin/obsidian-raise"
    },

    "custom/obsidian-sp": {
        "format": "",
        "tooltip": false
    },

    "group/hardware": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 300,
            "transition-left-to-right": false,
            "children-class": "hardware-child"
        },
        "modules": ["custom/hardware-toggle", "memory", "cpu"]
    },

    "custom/hardware-toggle": {
        "exec": "~/.config/waybar/hardware-status.sh",
        "return-type": "json",
        "interval": 3,
        "tooltip": false
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": false
    },

    "memory": {
        "format": "󰍛 {percentage}%",
        "interval": 5
    },

    "battery": {
        "states": { "warning": 50, "critical": 20 },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 30,
        "tooltip": false,
        "on-click": "python3 ~/.config/waybar/battery-popup.py"
    },

    "network": {
        "format-wifi": "󰤨 {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "interval": 5,
        "format-disconnected": "󰤭 ",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "python3 ~/.config/waybar/wifi-popup.py"
    },

    "swaync": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂚",
            "none": "󰂜",
            "dnd-notification": "󰂛",
            "dnd-none": "󰪑"
        },
        "on-click": "swaync-client -t",
        "on-click-right": "swaync-client -d"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 ",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "python3 ~/.config/waybar/sound-popup.py",
        "scroll-step": 5
    },

    "bluetooth": {
        "format": "󰂯 0",
        "format-connected": "󰂱 {num_connections}",
        "format-disabled": "󰂲",
        "tooltip-format": "{controller_alias} — {controller_address}",
        "tooltip-format-connected": "{controller_alias}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}  {device_address}",
        "on-click": "python3 ~/.config/waybar/bluetooth-popup.py"
    },

    "custom/displays": {
        "exec": "~/.config/waybar/displays-status.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "nwg-displays",
        "tooltip": true
    },

    "custom/drives": {
        "exec": "~/.config/waybar/drives-status.sh",
        "return-type": "json",
        "interval": 3,
        "on-click": "python3 ~/.config/waybar/drives-popup.py",
        "tooltip": true
    },

    "custom/vpn": {
        "exec": "~/.config/waybar/vpn.sh",
        "return-type": "json",
        "interval": 5,
        "on-click": "bash -c 'mullvad status | grep -q Connected && mullvad disconnect || mullvad connect'",
        "tooltip": true
    },

    "tray": {
        "spacing": 8,
        "icon-size": 16
    }
},
{
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 38,
    "spacing": 0,
    "modules-right": [
        "custom/music-ws", "custom/now-playing", "custom/np-prev", "custom/np-playpause", "custom/np-next"
    ],

    "custom/music-ws": {
        "exec": "~/.config/waybar/music-ws.sh",
        "return-type": "json",
        "on-click": "~/.local/bin/music-launch.sh",
        "tooltip": true
    },

    "custom/now-playing": {
        "exec": "~/.config/waybar/now-playing.sh",
        "return-type": "json",
        "on-click": "~/.local/bin/music-launch.sh",
        "tooltip": true
    },

    "custom/np-prev": {
        "exec": "~/.config/waybar/np-prev.sh",
        "return-type": "json",
        "on-click": "playerctl -p spotify previous",
        "tooltip": true
    },

    "custom/np-playpause": {
        "exec": "~/.config/waybar/np-playpause.sh",
        "return-type": "json",
        "on-click": "playerctl -p spotify status >/dev/null 2>&1 && playerctl -p spotify play-pause || setsid spotify >/dev/null 2>&1 < /dev/null &",
        "tooltip": true
    },

    "custom/np-next": {
        "exec": "~/.config/waybar/np-next.sh",
        "return-type": "json",
        "on-click": "playerctl -p spotify next",
        "tooltip": true
    }
}]
